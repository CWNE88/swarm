<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cwne88.swarm"
    android:versionCode="1"
    android:versionName="1">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi's multicast lock, for mDNS: being found on the network and finding others there. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- A call ringing: vibrating in vibrate mode, and kept awake with
         the screen off while it rings. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A camera's used if there is one, not needed. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:label="Swarm"
        android:hasCode="true"
        android:allowBackup="false">

        <!-- Not recreated when the phone turns or the keyboard comes and
             goes: swarm runs once per activity (see android/src/lib.rs). -->
        <activity
            android:name=".SwarmActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="swarm" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SwarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A serverless messenger: stays connected to peers directly, as there's no server to wake it" />
        </service>
    </application>
</manifest>
